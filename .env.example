# Copy this file to .env in the repository root (next to manage.py).
# That is the only dotenv file the settings read. Variables exported in the
# process environment take precedence over this file.

# Django settings
# The settings module decides DEBUG: config.settings.local turns it on,
# config.settings.production turns it off. There is no DEBUG variable.
# The settings module itself must be exported in the process environment to
# take effect; manage.py defaults to config.settings.local and
# src/config/wsgi.py to config.settings.production.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
# Used by config.settings.production (config.settings.local has a fixed list)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=sqlite:///db.sqlite3

# Admin URL (change in production for security)
DJANGO_ADMIN_URL=admin/

# Cache location (production only)
DJANGO_CACHE_LOCATION=/tmp/homelab_cache

# Email settings (optional, for production)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@home.wersdoerfer.de
SERVER_EMAIL=noreply@home.wersdoerfer.de

# Logging levels
DJANGO_LOG_LEVEL=INFO
HOMELAB_LOG_LEVEL=DEBUG

# Security (production only)
DJANGO_SECURE_SSL_REDIRECT=True
